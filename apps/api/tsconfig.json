{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@groundguard/contracts": ["../../packages/contracts/dist"],
      "@groundguard/types": ["../../packages/types/dist"]
    }
  },
  "include": ["src/**/*"]
}
