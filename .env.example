NODE_ENV=development
PORT=4000
WEB_PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/groundguard
REDIS_URL=redis://localhost:6379

AI_SERVICE_URL=http://localhost:8000
ML_SERVICE_URL=http://localhost:8001
# Option A: External Qdrant server (production / Docker)
QDRANT_URL=http://localhost:6333
# Option B: Disk-backed embedded Qdrant (no separate server, local dev only — takes precedence over QDRANT_URL)
# QDRANT_PATH=uploads/indexes/qdrant_embedded
TANTIVY_PATH=uploads/indexes/tantivy
GRAPHS_PATH=uploads/graphs

JWT_SECRET=dev_jwt_secret_change_me_in_production
JWT_EXPIRES_IN=24h

# Phase 4 & Phase 5 Retrieval Policies
# Configured sufficiency score threshold (S >= 0.35 per enterprise workflow)
SUFFICIENCY_THRESHOLD=0.35
ENABLE_RERANKER_BYPASS=true

# Phase 8 Recovery Policy
MAX_RECOVERY_ATTEMPTS=2

# Phase 5 Real LLM Configuration (Canonical Provider: Google Gemini)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-lite-latest
GEMINI_API_KEY=
