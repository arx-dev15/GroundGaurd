NODE_ENV=development
PORT=4000
WEB_PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/groundguard
REDIS_URL=redis://localhost:6379

AI_SERVICE_URL=http://localhost:8000
ML_SERVICE_URL=http://localhost:8001
# Option A (default): External Qdrant server (Docker / production). Authoritative vector store.
QDRANT_URL=http://localhost:6333
# Option B: Disk-backed embedded Qdrant (local dev only). Requires QDRANT_URL to be set EMPTY (QDRANT_URL=);
# QDRANT_PATH alone does not select embedded mode. Embedded and server stores hold separate vectors.
# QDRANT_PATH=uploads/indexes/qdrant_embedded
# If the server is unreachable, the AI service runs lexical-only and /health reports "degraded".
# Opt-in only: fall back to the embedded store instead (dev only, reported as backend=embedded_fallback).
# QDRANT_ALLOW_EMBEDDED_FALLBACK=false
TANTIVY_PATH=uploads/indexes/tantivy
GRAPHS_PATH=uploads/graphs

JWT_SECRET=dev_jwt_secret_change_me_in_production
JWT_EXPIRES_IN=24h

# Phase 4 & Phase 5 Retrieval Policies
# Configured sufficiency score threshold (S >= 0.35 per enterprise workflow)
SUFFICIENCY_THRESHOLD=0.35
ENABLE_RERANKER_BYPASS=true

# Phase 8 Recovery Policy
MAX_RECOVERY_ATTEMPTS=2

# Phase 5 Real LLM Configuration
# Supported providers: gemini, groq, openai, ollama. Defaults to gemini when omitted.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-lite-latest
GEMINI_API_KEY=
GROQ_API_KEY=
