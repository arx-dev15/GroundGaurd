# GroundGuard M2 AI Service Environment Configuration Template
# Copy to .env for local development. Never commit real secrets.

ENVIRONMENT=development
AI_SERVICE_PORT=8000

# Authoritative Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/groundguard

# Downstream Verification Service (M1 ML)
ML_SERVICE_URL=http://localhost:8001

# Vector Store (Qdrant)
# Production requires authoritative external Qdrant server at QDRANT_URL.
# Development: if the server is unreachable the service does NOT switch stores silently; it runs
# lexical-only, reports status "degraded" on /health (503 on /ready) and reconnects automatically.
# Explicit embedded mode: set QDRANT_URL= (empty) and QDRANT_PATH.
QDRANT_URL=http://localhost:6333
QDRANT_PATH=uploads/indexes/qdrant_embedded
# Opt-in dev-only fallback to the embedded store when the server is unreachable (backend=embedded_fallback).
QDRANT_ALLOW_EMBEDDED_FALLBACK=false
ALLOW_IN_MEMORY_FALLBACK=false

# Lexical & Graph Indices
TANTIVY_PATH=uploads/indexes/tantivy
GRAPHS_PATH=uploads/graphs

# Retrieval & Gate Policies
# Configured sufficiency score threshold (S >= 0.35 per enterprise workflow)
SUFFICIENCY_THRESHOLD=0.35
ENABLE_RERANKER_BYPASS=true

# Recovery Engine Policy
MAX_RECOVERY_ATTEMPTS=2

# Testing & Offline Flags (Strictly forbidden in production)
ALLOW_OFFLINE_DB=false
ALLOW_MOCK_EMBEDDER=false

# Real LLM Generation
# Supported providers: gemini, groq, openai, ollama. Defaults to gemini when omitted.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-lite-latest
GEMINI_API_KEY=
GROQ_API_KEY=
